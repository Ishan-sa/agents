# Reuse the same Google Sheet as lead-hunter / outreach-agent
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json

# Gmail OAuth — needs broader scope than outreach-agent (read replies + create
# in-thread drafts). Create a SEPARATE OAuth client + token.
GMAIL_OAUTH_CREDENTIALS_PATH=./gmail-oauth-credentials.json
GMAIL_TOKEN_PATH=./gmail-token.json

# Sender identity (used when drafting reply / follow-up bodies)
SENDER_NAME=
SENDER_AGENCY_NAME=
SENDER_CALENDAR_URL=

# Follow-up cadence (days)
FOLLOWUP_1_DAYS=5
FOLLOWUP_2_DAYS=12
COLD_DAYS=25

# LLM (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
